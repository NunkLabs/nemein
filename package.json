{
  "name": "tetribass-server",
  "repository": "https://github.com/NunkuGemu/tetribass-server",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -p src/web/tsconfig.json && vite build --config src/web/vite.config.ts",
    "check": "ultracite check",
    "clean": "rm -rf dist node_modules",
    "dev": "concurrently --kill-others \"tsc -w\" \"NODE_ENV=development nodemon dist/server/index.js\" \"vite --config src/web/vite.config.ts\"",
    "fix": "ultracite fix",
    "postinstall": "is-ci || husky",
    "start": "pnpm build && node dist/server/index.js",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,html,svg}": [
      "ultracite fix"
    ]
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.0.18",
    "@pixi/react": "^7.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "bufferutil": "^4.0.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.1",
    "framer-motion": "^11.0.24",
    "nanoid": "^5.0.6",
    "pixi.js": "^7.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sirv": "^3.0.0",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "utf-8-validate": "^6.0.3",
    "winston": "^3.13.0",
    "ws": "^8.16.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "is-ci": "^3.0.1",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "ultracite": "7.10.7",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
