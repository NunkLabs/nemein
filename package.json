{
  "name": "nemein",
  "repository": "https://github.com/NunkuGemu/nemein",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -p src/web/tsconfig.json && vite build --config src/web/vite.config.ts",
    "check": "ultracite check",
    "clean": "rm -rf dist node_modules",
    "dev": "concurrently --kill-others \"tsc -w\" \"NODE_ENV=development node --watch --watch-preserve-output dist/server/index.js\" \"vite --config src/web/vite.config.ts\"",
    "fix": "ultracite fix",
    "postinstall": "is-ci || husky",
    "start": "pnpm build && node dist/server/index.js",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,html,svg}": [
      "ultracite fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@pixi/react": "^8.0.5",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eventemitter3": "^5.0.4",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.4.1",
    "oxc-transform-react": "^0.145.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
